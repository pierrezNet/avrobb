PORT=3000

# Base MariaDB au schéma FluxBB (conteneur pv_db de la pile Docker de développement) ; D1 au lot 3
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=pv
DB_PASSWORD=pv
DB_NAME=pilotevirtuel
DB_PREFIX=fo_

# Secret des signatures (cookie de session, jetons CSRF) : au moins 32 caractères aléatoires
# (openssl rand -hex 32). Le changer déconnecte tout le monde.
SESSION_SECRET=
# 1 en HTTPS : cookies marqués Secure
COOKIE_SECURE=0
# 1 en développement : connexion sous le nom d'un membre, sans mot de passe, depuis cette machine seulement
DEV_LOGIN=1

# Stockage local des fichiers envoyés (galerie, avatars, logo, bannière) ; R2 au lot 4
STORAGE_DIR=storage

# 1 si Node est derrière un reverse proxy (IP du client lue dans X-Forwarded-For)
TRUST_PROXY=0

# Sans SMTP dans l'administration (o_smtp_host) : e-mails écrits dans ce dossier (.eml) plutôt qu'envoyés par sendmail
MAIL_OUTBOX=mail-outbox
