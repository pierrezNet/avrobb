{
	"name": "avrobb",
	"version": "0.1.0",
	"private": true,
	"description": "AvroBB, forum d'échange autour de projets personnels (Node/TypeScript, MVC) ; cible Cloudflare Workers",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node scripts/build-templates.mjs && node scripts/dev.mjs",
		"build": "node scripts/build.mjs",
		"build:templates": "node scripts/build-templates.mjs",
		"start": "node --env-file=.env --enable-source-maps dist/server.js",
		"test": "node scripts/build-templates.mjs && vitest run",
		"typecheck": "node scripts/build-templates.mjs && tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "node scripts/build-templates.mjs && biome check . && tsc --noEmit && vitest run",
		"screenshot": "tsx scripts/screenshot.ts",
		"test:db": "node scripts/build-templates.mjs && vitest run --config vitest.db.config.ts"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.5",
		"hono": "^4.13.14",
		"kysely": "^0.29.7",
		"mysql2": "^3.24.6",
		"nodemailer": "^7.0.13",
		"nunjucks": "^3.2.4",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/node": "^26.6.5",
		"@types/nodemailer": "^8.0.2",
		"@types/nunjucks": "^3.2.6",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
