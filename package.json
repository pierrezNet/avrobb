{
	"name": "pv-forum",
	"version": "0.1.0",
	"private": true,
	"description": "Prototype de forum Node.js (MVC) sur le schéma FluxBB de Pilote-Virtuel",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "tsx watch --env-file=.env src/server.ts",
		"start": "tsx --env-file=.env src/server.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "biome check . && tsc --noEmit && vitest run",
		"screenshot": "tsx scripts/screenshot.ts",
		"test:db": "vitest run --config vitest.db.config.ts",
		"parity": "tsx scripts/parity.ts",
		"bbcode:reference": "tsx scripts/bbcode-reference.ts"
	},
	"dependencies": {
		"@fastify/cookie": "^11.1.3",
		"@fastify/static": "^10.1.7",
		"@fastify/view": "^12.0.1",
		"fastify": "^5.12.7",
		"kysely": "^0.29.7",
		"mysql2": "^3.24.6",
		"nodemailer": "^7.0.13",
		"nunjucks": "^3.2.4",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/node": "^26.6.5",
		"@types/nodemailer": "^8.0.2",
		"@types/nunjucks": "^3.2.6",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
