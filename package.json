{
	"name": "avrobb",
	"version": "0.1.0",
	"private": true,
	"description": "AvroBB, forum d'échange autour de projets personnels (TypeScript, Cloudflare Workers, D1, R2)",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node scripts/build.mjs && node scripts/dev.mjs",
		"build": "node scripts/build.mjs",
		"test": "node scripts/build.mjs && vitest run",
		"typecheck": "node scripts/build.mjs && tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "node scripts/build.mjs && biome check . && tsc --noEmit && vitest run",
		"screenshot": "tsx scripts/screenshot.ts",
		"test:db": "node scripts/build.mjs && vitest run --config vitest.db.config.ts",
		"db:migrate": "wrangler d1 migrations apply avrobb --local",
		"db:seed:dev": "wrangler d1 execute avrobb --local --file scripts/dev-seed.sql",
		"deploy": "node scripts/build.mjs && wrangler deploy"
	},
	"dependencies": {
		"hono": "^4.13.14",
		"kysely": "^0.29.7",
		"nunjucks": "^3.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/node": "^26.6.5",
		"@types/nunjucks": "^3.2.6",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"wrangler": "^4.156.0"
	}
}
