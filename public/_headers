# En-têtes des ressources servies par Workers Static Assets (le Worker n'est pas appelé pour elles).
# Leurs adresses portent une empreinte du contenu (?v=…) : on peut les garder longtemps en cache.
/assets/*
  Cache-Control: public, max-age=2592000, immutable
  X-Content-Type-Options: nosniff

# Service worker : toujours revalidé, pour qu'une nouvelle version soit prise tout de suite.
/sw.js
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# Page hors ligne, gardée par le service worker.
/offline
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; style-src 'unsafe-inline'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
