{#- Catégories (admin_categories.php). Données : `view` (presenters/adminForumsPage.ts). -#}
{% extends "layout.njk" %}
{% import "partials/adminMenu.njk" as adminMenu %}
{% import "partials/forms.njk" as forms %}
{% import "partials/sideMenu.njk" as sideMenu %}

{% block main %}
{% set t = lang.adminForums %}
<h1 class="page-title">{{ t.categories }}</h1>
<div class="side-layout">
{{ adminMenu.menu(view.menu, lang) }}
<div class="side-layout__content">
{{ sideMenu.notice(view.notice) }}
{{ forms.errors(lang.profile.formErrors, lang.profile.formErrorsInfo, view.errors) }}
{% if view.confirmDelete %}
<form class="form-box form" method="post" action="{{ url('admin_categories.php') }}">
	{{ forms.csrf(layout) }}
	<input type="hidden" name="cat_to_delete" value="{{ view.confirmDelete.id }}">
	<h2 class="form-box__title">{{ t.deleteCategoryHead }}</h2>
	<p>{{ t.confirmDeleteCategoryInfo(view.confirmDelete.name) }}</p>
	<p class="form__warning"><strong>{{ t.deleteCategoryWarn }}</strong></p>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="del_cat_comply" value="1">{{ t.delete }}</button> <a class="button" href="{{ url('admin_categories.php') }}">{{ t.goBack }}</a></p>
</form>
{% else %}
<form class="form-box form" method="post" action="{{ url('admin_categories.php') }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ t.addCategoriesHead }}</h2>
	<p class="form__field">
		<label for="new_cat_name">{{ t.addCategoryLabel }}</label>
		<input type="text" id="new_cat_name" name="new_cat_name" maxlength="80" aria-describedby="new_cat_help">
		<span id="new_cat_help" class="form__help">{{ t.addCategoryHelp }}</span>
	</p>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="add_cat" value="1">{{ t.add }}</button></p>
</form>
{% if view.categories.length %}
<form class="form-box form" method="post" action="{{ url('admin_categories.php') }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ t.deleteCategoriesHead }}</h2>
	<p class="form__field">
		<label for="cat_to_delete">{{ t.deleteCategoryLabel }}</label>
		<select id="cat_to_delete" name="cat_to_delete" aria-describedby="cat_delete_help">
			{% for cat in view.categories %}<option value="{{ cat.id }}">{{ cat.name }}</option>{% endfor %}
		</select>
		<span id="cat_delete_help" class="form__help">{{ t.deleteCategoryHelp }}</span>
	</p>
	<p class="form__buttons"><button type="submit" class="button" name="del_cat" value="1">{{ t.delete }}</button></p>
</form>
<form class="form-box form" method="post" action="{{ url('admin_categories.php') }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ t.editCategoriesHead }}</h2>
	<ul class="admin-rows">
		{% for cat in view.categories %}
		<li class="admin-rows__item">
			<p class="form__field admin-rows__main">
				<label for="cat-{{ cat.id }}-name">{{ t.categoryName }}</label>
				<input type="text" id="cat-{{ cat.id }}-name" name="cat[{{ cat.id }}][name]" value="{{ cat.name }}" maxlength="80" required>
			</p>
			<p class="form__field admin-rows__position">
				<label for="cat-{{ cat.id }}-order">{{ t.position }}</label>
				<input type="number" id="cat-{{ cat.id }}-order" name="cat[{{ cat.id }}][order]" value="{{ cat.position }}" min="0" max="999" inputmode="numeric" required>
			</p>
		</li>
		{% endfor %}
	</ul>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="update" value="1">{{ t.update }}</button></p>
</form>
{% endif %}
{% endif %}
</div>
</div>
{% endblock %}
