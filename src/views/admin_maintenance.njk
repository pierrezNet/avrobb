{#- Maintenance du forum (admin_maintenance.php). Données : `view` (controllers/AdminMaintenanceController.ts). -#}
{% extends "layout.njk" %}
{% import "partials/adminMenu.njk" as adminMenu %}
{% import "partials/forms.njk" as forms %}
{% import "partials/sideMenu.njk" as sideMenu %}

{% block main %}
{% set t = lang.adminMaintenance %}
<h1 class="page-title">{{ t.title }}</h1>
<div class="side-layout">
{{ adminMenu.menu(view.menu, lang) }}
<div class="side-layout__content">
{{ sideMenu.notice(view.notice) }}
<form class="form-box form options-form" id="maintenance-mode" method="post" action="{{ url('admin_maintenance.php') }}">
	{{ forms.csrf(layout) }}
	<input type="hidden" name="action" value="mode">
	<h2 class="form-box__title">{{ t.modeSubhead }}</h2>
	<p class="form__help">{{ t.modeInfo }}</p>
	<div class="form__field" role="radiogroup" aria-labelledby="label-maintenance">
		<span id="label-maintenance" class="form__label">{{ t.modeLabel }}</span>
		<label class="form__choice"><input type="radio" name="maintenance" value="1"{% if view.mode.enabled %} checked{% endif %}> {{ t.modeOn }}</label>
		<label class="form__choice"><input type="radio" name="maintenance" value="0"{% if not view.mode.enabled %} checked{% endif %}> {{ t.modeOff }}</label>
	</div>
	<p class="form__field"><label for="maintenance_message">{{ t.modeMessage }}</label><textarea id="maintenance_message" name="maintenance_message" rows="5" aria-describedby="maintenance_message_help">{{ view.mode.message }}</textarea><span id="maintenance_message_help" class="form__help">{{ t.modeMessageHelp }}</span></p>
	<p class="form__buttons"><button type="submit" class="button button--primary">{{ t.modeSave }}</button> <a href="{{ url(view.mode.previewHref) }}" target="_blank" rel="noopener">{{ t.modePreview }}</a></p>
</form>
<form class="form-box form options-form" method="post" action="{{ url('admin_maintenance.php') }}">
	{{ forms.csrf(layout) }}
	<input type="hidden" name="action" value="rebuild">
	<h2 class="form-box__title">{{ t.rebuildSubhead }}</h2>
	<p class="form__help">{{ t.rebuildInfo }}</p>
	<p class="form__field"><label for="i_per_page">{{ t.perCycle }}</label><input type="number" id="i_per_page" name="i_per_page" value="300" min="1" max="9999" inputmode="numeric" aria-describedby="i_per_page_help"><span id="i_per_page_help" class="form__help">{{ t.perCycleHelp }}</span></p>
	<p class="form__field"><label for="i_start_at">{{ t.startingPost }}</label><input type="number" id="i_start_at" name="i_start_at" value="{{ view.firstPostId }}" min="0" inputmode="numeric" aria-describedby="i_start_at_help"><span id="i_start_at_help" class="form__help">{{ t.startingPostHelp }}</span></p>
	<div class="form__field"><label class="form__choice"><input type="checkbox" name="i_empty_index" value="1" checked> {{ t.emptyIndex }}</label><span class="form__help">{{ t.emptyIndexHelp }}</span></div>
	<p class="form__help">{{ t.rebuildCompletedInfo }}</p>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="rebuild_index" value="1">{{ t.rebuild }}</button></p>
</form>
<form class="form-box form options-form" id="cold-topics" method="post" action="{{ url('admin_maintenance.php') }}">
	{{ forms.csrf(layout) }}
	<input type="hidden" name="action" value="cold">
	<h2 class="form-box__title">{{ t.coldSubhead }}</h2>
	<p class="form__help">{{ t.coldInfo }}</p>
	<p class="form__field"><label for="cold_days">{{ t.coldDays }}</label><input type="number" id="cold_days" name="cold_days" value="{{ view.coldTopicDays }}" min="0" max="9999" inputmode="numeric" required aria-describedby="cold_days_help"><span id="cold_days_help" class="form__help">{{ t.coldDaysHelp }}</span></p>
	<p class="form__buttons"><button type="submit" class="button button--primary">{{ t.modeSave }}</button></p>
</form>
</div>
</div>
{% endblock %}
