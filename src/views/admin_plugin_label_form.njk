{#- Ajout ou édition d'une balise (plugin AP_Balises.php). Données : `view` (controllers/AdminLoaderController.ts). -#}
{% extends "layout.njk" %}
{% import "partials/adminMenu.njk" as adminMenu %}
{% import "partials/forms.njk" as forms %}

{% block main %}
{% set t = lang.adminPlugins.labels %}
{% set v = view.values %}
<h1 class="page-title">{{ t.editTitle if view.editing else t.addTitle }}</h1>
<div class="side-layout">
{{ adminMenu.menu(view.menu, lang) }}
<div class="side-layout__content">
{{ forms.errors(lang.profile.formErrors, lang.profile.formErrorsInfo, view.errors) }}
<form class="form-box form options-form" method="post" action="{{ url(view.submitAction) }}">
	{{ forms.csrf(layout) }}
	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ t.legend }}</legend>
		<p class="form__field"><label for="nom">{{ t.name }}</label><input type="text" id="nom" name="nom" value="{{ v.name }}" maxlength="50" required aria-describedby="nom_help"><span id="nom_help" class="form__help">{{ t.nameHelp }}</span></p>
		<p class="form__field"><label for="color1">{{ t.color }}</label><input type="color" id="color1" name="color1" value="{{ v.color }}"></p>
		<div class="form__field" role="group" aria-labelledby="label-deco">
			<span id="label-deco" class="form__label">{{ t.decoration }}</span>
			<label class="form__choice"><input type="checkbox" name="gras" value="1"{% if v.bold %} checked{% endif %}> {{ t.bold }}</label>
			<label class="form__choice"><input type="checkbox" name="ital" value="1"{% if v.italic %} checked{% endif %}> {{ t.italic }}</label>
			<label class="form__choice"><input type="checkbox" name="souli" value="1"{% if v.underline %} checked{% endif %}> {{ t.underline }}</label>
		</div>
		{% if view.editing %}<p class="form__field"><label for="position">{{ t.position }}</label><input type="number" id="position" name="position" value="{{ v.position }}" inputmode="numeric"></p>{% endif %}
		<div class="form__field" role="radiogroup" aria-labelledby="label-style">
			<span id="label-style" class="form__label">{{ t.style }}</span>
			{% for s in view.styles %}<label class="form__choice"><input type="radio" name="baltype" value="{{ s.value }}"{% if s.value == v.style %} checked{% endif %}> {{ s.name }}</label>{% endfor %}
		</div>
		<div class="form__field" role="radiogroup" aria-labelledby="label-affich">
			<span id="label-affich" class="form__label">{{ t.moderatorVisible }}</span>
			<label class="form__choice"><input type="radio" name="affich" value="1"{% if v.moderatorVisible %} checked{% endif %}> {{ t.yes }}</label>
			<label class="form__choice"><input type="radio" name="affich" value="0"{% if not v.moderatorVisible %} checked{% endif %}> {{ t.no }}</label>
		</div>
	</fieldset>
	<p class="form__buttons"><button type="submit" class="button button--primary">{{ t.save }}</button> <a class="button" href="{{ url('admin_loader.php?plugin=AP_Balises.php') }}">{{ t.goBack }}</a></p>
</form>
</div>
</div>
{% endblock %}
