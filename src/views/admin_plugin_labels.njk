{#- Page Balises de l'administration (admin_loader.php?plugin=AP_Balises.php) : balises du sujet, en
    pastilles. Données : `view` (controllers/adminPlugins/LabelsPlugin.ts). -#}
{% extends "layout.njk" %}
{% import "partials/adminMenu.njk" as adminMenu %}
{% import "partials/forms.njk" as forms %}
{% import "partials/sideMenu.njk" as sideMenu %}

{% macro pill(name, colors) %}<span class="subject-tag" style="background-color: {{ colors.background }}; color: {{ colors.foreground }}">{{ name }}</span>{% endmacro %}

{% block main %}
{% set t = lang.adminPlugins.labels %}
<h1 class="page-title">{{ t.title }}</h1>
<div class="side-layout">
{{ adminMenu.menu(view.menu, lang) }}
<div class="side-layout__content">
{{ sideMenu.notice(view.notice) }}
<p>{{ t.intro }}</p>
<section class="form-box" aria-labelledby="subject-tags">
	<h2 id="subject-tags" class="form-box__title">{{ t.subjectTagsHead }}</h2>
	<p class="form__help">{{ t.subjectTagsInfo }}</p>
	{% for group in view.subjectTagGroups %}
	<h3 class="form__legend">{{ group.name }}</h3>
	<ul class="admin-rows">
		{% for tag in group.tags %}
		<li class="admin-rows__item">
			<p class="admin-rows__main">{{ pill(tag.name, tag.colors) }} <span class="form__help">{{ tag.colors.background }}</span></p>
			<form method="post" action="{{ url(tag.upAction) }}" class="inline-form">{{ forms.csrf(layout) }}<button type="submit" class="button button--small" aria-label="{{ t.moveUp(tag.name) }}">↑</button></form>
			<form method="post" action="{{ url(tag.downAction) }}" class="inline-form">{{ forms.csrf(layout) }}<button type="submit" class="button button--small" aria-label="{{ t.moveDown(tag.name) }}">↓</button></form>
			<p><a href="{{ url(tag.editHref) }}">{{ t.edit }}</a> · <a href="{{ url(tag.deleteHref) }}">{{ t.delete }}</a></p>
		</li>
		{% endfor %}
	</ul>
	{% endfor %}
	<p><a class="button button--primary" href="{{ url(view.addSubjectTagHref) }}">{{ t.addSubjectTag }}</a></p>
</section>
</div>
</div>
{% endblock %}
