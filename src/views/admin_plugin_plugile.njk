{#- Plugin Plugile (admin_loader.php?plugin=AP_Plugile.php). Données : `view` (controllers/AdminLoaderController.ts). -#}
{% extends "layout.njk" %}
{% import "partials/adminMenu.njk" as adminMenu %}
{% import "partials/forms.njk" as forms %}
{% import "partials/sideMenu.njk" as sideMenu %}

{% block main %}
{% set t = lang.adminPlugins.plugile %}
<h1 class="page-title">{{ t.title }} {{ view.version }}</h1>
<div class="side-layout">
{{ adminMenu.menu(view.menu, lang) }}
<div class="side-layout__content">
{{ sideMenu.notice(view.notice) }}
<form class="form-box form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<p class="form__help">{{ t.intro }}</p>
	<h2 class="form-box__title">{{ t.install }}</h2>
	<p>{{ t.installInfo }}</p>
	<p class="form__buttons"><button type="submit" class="button" name="update" value="1">{{ t.install }}</button></p>
	<h2 class="form-box__title">{{ t.uninstall }}</h2>
	<p>{{ t.uninstallInfo }}</p>
	<p class="form__buttons"><button type="submit" class="button" name="delete" value="1">{{ t.uninstall }}</button></p>
</form>
{% if view.installed %}
<form class="form-box form options-form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ t.configuration }}</h2>
	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ t.settings }}</legend>
		<div class="form__field" role="radiogroup" aria-labelledby="label-menu">
			<span id="label-menu" class="form__label">{{ t.menu }}</span>
			<label class="form__choice"><input type="radio" name="menu" value="1"{% if view.separateMenu %} checked{% endif %}> {{ t.yes }}</label>
			<label class="form__choice"><input type="radio" name="menu" value="0"{% if not view.separateMenu %} checked{% endif %}> {{ t.no }}</label>
		</div>
		<p class="form__field"><label for="plugile_menu_name">{{ t.menuTitle }}</label><input type="text" id="plugile_menu_name" name="plugile_menu_name" value="{{ view.menuName }}" maxlength="50"></p>
	</fieldset>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="saveconfig" value="1">{{ t.submit }}</button></p>
</form>
{% else %}
<p>{{ t.notInstalled }}</p>
{% endif %}
</div>
</div>
{% endblock %}
