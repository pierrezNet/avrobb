{#- Plugin Premium (admin_loader.php?plugin=AP_Premium.php). Données : `view` (controllers/AdminLoaderController.ts). -#}
{% extends "layout.njk" %}
{% import "partials/adminMenu.njk" as adminMenu %}
{% import "partials/forms.njk" as forms %}
{% import "partials/sideMenu.njk" as sideMenu %}

{% block main %}
{% set t = lang.adminPlugins.premium %}
<h1 class="page-title">{{ t.title }}</h1>
<div class="side-layout">
{{ adminMenu.menu(view.menu, lang) }}
<div class="side-layout__content">
{{ sideMenu.notice(view.notice) }}
{{ forms.errors(lang.profile.formErrors, lang.profile.formErrorsInfo, view.errors) }}
<form class="form-box form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<p>{{ t.description1 }} {{ t.description2 }}</p>
	<p><strong>{{ t.installed if view.installed else t.notInstalled }}</strong></p>
	<h2 class="form-box__title">{{ t.uninstall if view.installed else t.install }}</h2>
	<p class="form__help">{{ t.installLegend }}</p>
	<p class="form__buttons">
		{% if view.installed %}<button type="submit" class="button" name="cancel" value="1">{{ t.uninstall }}</button>
		{% else %}<button type="submit" class="button button--primary" name="install" value="1">{{ t.install }}</button>{% endif %}
	</p>
</form>
{% if view.installed %}
<form class="form-box form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ t.addPremium }}</h2>
	<p class="form__help">{{ t.allNeeded }}</p>
	<p class="form__field"><label for="courriel">{{ t.email }}</label><input type="email" id="courriel" name="courriel" maxlength="80" required></p>
	<p class="form__field"><label for="group_id_premium">{{ t.group }}</label><select id="group_id_premium" name="group_id_premium">{% for g in view.groups %}<option value="{{ g.id }}"{% if g.selected %} selected{% endif %}>{{ g.title }}</option>{% endfor %}</select></p>
	<p class="form__field"><label for="end_premium">{{ t.period }}</label><input type="number" id="end_premium" name="end_premium" min="1" inputmode="numeric" required></p>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="add_user" value="1">{{ t.send }}</button></p>
</form>
<form class="form-box form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ t.deletePremium }}</h2>
	<p class="form__help">{{ t.deleteLegend }}</p>
	<ul class="admin-rows">
		{% for m in view.members %}
		<li class="admin-rows__item">
			<p class="admin-rows__main"><strong>{{ m.username }}</strong> — {{ m.email }}<br>{{ t.group }}&#160;: {{ m.groupTitle }} · {{ t.remaining }}&#160;: {{ m.remaining }}</p>
			<label class="form__choice"><input type="checkbox" name="delete_prem[{{ m.id }}]" value="1"> {{ t.select(m.username) }}</label>
		</li>
		{% endfor %}
	</ul>
	{% if view.members.length %}<p class="form__buttons"><button type="submit" class="button" name="delete_user" value="1">{{ t.delete }}</button></p>{% endif %}
</form>
{% endif %}
</div>
</div>
{% endblock %}
