{#- Plugin Smilies (admin_loader.php?plugin=AP_Smilies.php). Données : `view` (controllers/AdminLoaderController.ts). -#}
{% extends "layout.njk" %}
{% import "partials/adminMenu.njk" as adminMenu %}
{% import "partials/forms.njk" as forms %}
{% import "partials/sideMenu.njk" as sideMenu %}

{% block main %}
{% set t = lang.adminPlugins.smilies %}
<h1 class="page-title">{{ t.title }}</h1>
<div class="side-layout">
{{ adminMenu.menu(view.menu, lang) }}
<div class="side-layout__content">
{{ sideMenu.notice(view.notice) }}
{{ forms.errors(lang.profile.formErrors, lang.profile.formErrorsInfo, view.errors) }}
<p>{{ t.intro }}</p>
<form class="form-box form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ t.currentSmilies }}</h2>
	{% if view.smilies.length %}
	<ul class="admin-rows">
		{% for s in view.smilies %}
		<li class="admin-rows__item">
			<img src="{{ s.imageUrl }}" alt="{{ s.text }}" width="20" height="20">
			<p class="form__field admin-rows__position"><label for="code-{{ s.id }}">{{ t.code }}</label><input type="text" id="code-{{ s.id }}" name="smilies_code[{{ s.id }}]" value="{{ s.text }}" maxlength="20"></p>
			<p class="form__field admin-rows__main"><label for="img-{{ s.id }}">{{ t.image }}</label><select id="img-{{ s.id }}" name="smilies_img[{{ s.id }}]">{% for c in s.choices %}<option value="{{ c.name }}"{% if c.selected %} selected{% endif %}>{{ c.name }}</option>{% endfor %}</select></p>
			<p class="form__field admin-rows__position"><label for="order-{{ s.id }}">{{ t.position }}</label><input type="number" id="order-{{ s.id }}" name="smilies_order[{{ s.id }}]" value="{{ s.position }}" inputmode="numeric"></p>
			<label class="form__choice"><input type="checkbox" name="rem_smilies[{{ s.id }}]" value="1"> {{ t.removeOf(s.text) }}</label>
		</li>
		{% endfor %}
	</ul>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="reord" value="1">{{ t.editSmilies }}</button> <button type="submit" class="button" name="remove" value="1">{{ t.removeSelected }}</button></p>
	{% else %}
	<p>{{ t.noSmiley }}</p>
	{% endif %}
</form>
<form class="form-box form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ t.submitNew }}</h2>
	<p class="form__field"><label for="smiley_code">{{ t.smileyCode }}</label><input type="text" id="smiley_code" name="smiley_code" maxlength="20" aria-describedby="smiley_code_help"><span id="smiley_code_help" class="form__help">{{ t.smileyCodeHelp }}</span></p>
	<p class="form__field"><label for="smiley_image">{{ t.smileyImage }}</label><select id="smiley_image" name="smiley_image">{% for i in view.images %}<option value="{{ i.name }}">{{ i.name }}</option>{% endfor %}</select></p>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="add_smiley" value="1">{{ t.submitSmiley }}</button></p>
</form>
<form class="form-box form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ t.images }}</h2>
	<ul class="smiley-images">
		{% for i in view.images %}
		<li><label class="form__choice"><input type="checkbox" name="del_smilies[{{ i.name }}]" value="1"> <img src="{{ i.url }}" alt="" width="20" height="20"> <span>{{ i.name }}</span></label></li>
		{% endfor %}
	</ul>
	<p class="form__buttons"><button type="submit" class="button" name="delete" value="1">{{ t.deleteSelected }}</button></p>
</form>
<form class="form-box form" method="post" action="{{ url(view.formAction) }}" enctype="multipart/form-data">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ t.addImage }}</h2>
	<p class="form__field"><label for="req_file">{{ t.imageFile }}</label><input type="file" id="req_file" name="req_file" accept="image/gif,image/jpeg,image/png" aria-describedby="req_file_help"><span id="req_file_help" class="form__help">{{ t.imageFileHelp }}</span></p>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="add_image" value="1">{{ t.upload }}</button></p>
</form>
</div>
</div>
{% endblock %}
