{#- Plugin Uploadile (admin_loader.php?plugin=AP_Uploadile.php). Données : `view` (controllers/AdminLoaderController.ts). -#}
{% extends "layout.njk" %}
{% import "partials/adminMenu.njk" as adminMenu %}
{% import "partials/forms.njk" as forms %}
{% import "partials/sideMenu.njk" as sideMenu %}

{% block main %}
{% set t = lang.adminPlugins.uploadile %}
{% set c = view.settings %}
<h1 class="page-title">{{ t.title }}</h1>
<div class="side-layout">
{{ adminMenu.menu(view.menu, lang) }}
<div class="side-layout__content">
{{ sideMenu.notice(view.notice) }}
<form class="form-box form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<p class="form__help">{{ t.intro }}</p>
	<p><button type="submit" class="button" name="installation" value="1">{{ t.install }}</button> {{ t.installInfo }}</p>
	<p class="form__help">{{ t.uninstallUnavailable }}</p>
</form>
<form class="form-box form options-form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ t.configuration }}</h2>
	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ t.legend }}</legend>
		<p class="form__field"><label for="laws">{{ t.laws }}</label><input type="text" id="laws" name="laws" value="{{ c.laws }}" aria-describedby="laws_help"><span id="laws_help" class="form__help">{{ t.lawsHelp }}</span></p>
		<div class="form__field" role="radiogroup" aria-labelledby="label-thumb">
			<span id="label-thumb" class="form__label">{{ t.thumb }}</span>
			<label class="form__choice"><input type="radio" name="thumb" value="1"{% if c.thumb %} checked{% endif %}> {{ t.yes }}</label>
			<label class="form__choice"><input type="radio" name="thumb" value="0"{% if not c.thumb %} checked{% endif %}> {{ t.no }}</label>
		</div>
		<p class="form__field"><label for="thumb_size">{{ t.thumbSize }}</label><input type="number" id="thumb_size" name="thumb_size" value="{{ c.thumbSize }}" min="1" inputmode="numeric"></p>
		<p class="form__field"><label for="maxsize_member">{{ t.maxsizeMember }}</label><input type="number" id="maxsize_member" name="maxsize_member" value="{{ c.maxsizeMember }}" min="1" inputmode="numeric"></p>
		<p class="form__field"><label for="limit_member">{{ t.limitMember }}</label><input type="number" id="limit_member" name="limit_member" value="{{ c.limitMember }}" min="1" inputmode="numeric"></p>
		<p class="form__field"><label for="maxsize_modo">{{ t.maxsizeModo }}</label><input type="number" id="maxsize_modo" name="maxsize_modo" value="{{ c.maxsizeModo }}" min="1" inputmode="numeric"></p>
		<p class="form__field"><label for="limit_modo">{{ t.limitModo }}</label><input type="number" id="limit_modo" name="limit_modo" value="{{ c.limitModo }}" min="1" inputmode="numeric"></p>
	</fieldset>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="update" value="1">{{ t.update }}</button></p>
</form>
<form class="form-box form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ t.files }}</h2>
	{% if view.files.length %}
	<ul class="admin-rows">
		{% for f in view.files %}
		<li class="admin-rows__item">
			{% if f.thumbnailUrl %}<a href="{{ f.url }}"><img src="{{ f.thumbnailUrl }}" alt="{{ f.label }}" class="upload-thumb" loading="lazy"></a>{% endif %}
			<p class="admin-rows__main"><strong>{{ f.owner }}</strong><br><a href="{{ f.url }}">{{ f.label }}</a> [{{ f.sizeText }}][{{ f.type }}]{% if not f.thumbnailUrl %} · {{ t.noPreview }}{% endif %}</p>
			<label class="form__choice"><input type="checkbox" name="delete[{{ f.key }}]" value="1"> {{ t.select(f.label, f.owner) }}</label>
		</li>
		{% endfor %}
	</ul>
	<p class="form__buttons"><button type="submit" class="button" name="supprimer" value="1">{{ t.delete }}</button></p>
	{% else %}
	<p>{{ t.noFiles }}</p>
	{% endif %}
</form>
</div>
</div>
{% endblock %}
