{#- Plugin « Gestion d'utilisateur » (admin_loader.php?plugin=AMP_Gestion_utilisateurs.php). Données : `view` (controllers/AdminLoaderController.ts). -#}
{% extends "layout.njk" %}
{% import "partials/adminMenu.njk" as adminMenu %}
{% import "partials/forms.njk" as forms %}
{% import "partials/sideMenu.njk" as sideMenu %}

{% block main %}
{% set t = lang.adminPlugins.userManagement %}
<h1 class="page-title">{{ t.title }}</h1>
<div class="side-layout">
{{ adminMenu.menu(view.menu, lang) }}
<div class="side-layout__content">
{{ sideMenu.notice(view.notice) }}
{{ forms.errors(lang.profile.formErrors, lang.profile.formErrorsInfo, view.errors) }}
<form class="form-box form options-form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ t.addHead }}</h2>
	<p class="form__help">{{ t.intro }}</p>
	<p class="form__field"><label for="username">{{ t.username }}</label><input type="text" id="username" name="username" maxlength="25" required autocomplete="off"></p>
	<p class="form__field"><label for="email">{{ t.email }}</label><input type="email" id="email" name="email" maxlength="80" required autocomplete="off"></p>
	<div class="form__field" role="radiogroup" aria-labelledby="label-random_pass" aria-describedby="help-random_pass">
		<span id="label-random_pass" class="form__label">{{ t.randomPass }}</span>
		<label class="form__choice"><input type="radio" name="random_pass" value="1"> {{ t.yes }}</label>
		<label class="form__choice"><input type="radio" name="random_pass" value="0" checked> {{ t.no }}</label>
		<span id="help-random_pass" class="form__help">{{ t.randomPassHelp }}</span>
	</div>
	<p class="form__field"><label for="password">{{ t.password }}</label><input type="text" id="password" name="password" maxlength="50" autocomplete="new-password" aria-describedby="password_help"><span id="password_help" class="form__help">{{ t.passwordHelp }}</span></p>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="add_user" value="1">{{ t.create }}</button></p>
</form>
</div>
</div>
{% endblock %}
