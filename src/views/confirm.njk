{#- Confirmation d'une action qui écrit, demandée par un lien GET ou avant une suppression.
    Données : `view` { title, text, action, button, hidden? (champs { name, value } à renvoyer) }. -#}
{% extends "layout.njk" %}
{% import "partials/forms.njk" as forms %}

{% block main %}
<form class="message-box" method="post" action="{{ url(view.action) }}">
	{{ forms.csrf(layout) }}
	{% for field in view.hidden or [] %}<input type="hidden" name="{{ field.name }}" value="{{ field.value }}">{% endfor %}
	<h1 class="message-box__title">{{ view.title }}</h1>
	<p>{{ view.text }}</p>
	<p><button type="submit" class="button button--primary">{{ view.button }}</button></p>
</form>
{% endblock %}
