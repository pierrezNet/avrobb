{#- Galerie de PV (gallery.php, consultation). Données : `view` (presenters/galleryPage.ts). -#}
{% extends "layout.njk" %}
{% import "partials/navigation.njk" as navigation %}
{% import "partials/sideMenu.njk" as sideMenu %}

{% block main %}
<h1 class="page-title">{{ view.heading }}</h1>
<p class="page-intro">{{ view.intro }}</p>
{{ sideMenu.notice(view.notice) }}
{% if view.filters.length %}
<nav class="gallery-filters" aria-label="{{ lang.gallery.pageTitle }}">
	{% for filter in view.filters %}<a href="{{ url(filter.href) }}"{% if filter.active %} aria-current="page"{% endif %}>{{ filter.label }}</a>{% endfor %}
</nav>
{% endif %}
<form class="picker-search" method="get" action="{{ url('gallery.php') }}" role="search" aria-label="{{ lang.gallery.pickerSearch }}">
	{% if view.search.mine %}<input type="hidden" name="mine" value="1">{% endif %}
	<p class="picker-search__field">
		<label for="gallery-q">{{ lang.gallery.searchLabel }}</label>
		<input id="gallery-q" type="search" name="q" value="{{ view.search.query }}" maxlength="80">
	</p>
	<p class="picker-search__submit"><button type="submit" class="button">{{ lang.gallery.searchButton }}</button></p>
</form>
{% if view.addUrl or view.moderationUrl %}
<p class="page-bar__actions">
	{% if view.addUrl %}<a class="button button--primary" href="{{ url(view.addUrl) }}">{{ lang.gallery.addPicture }}</a>{% endif %}
	{% if view.moderationUrl %}<a class="button" href="{{ url(view.moderationUrl) }}">{{ lang.gallery.moderation }}</a>{% endif %}
</p>
{% endif %}
<div class="page-bar">{{ navigation.pagination(view.pagination, lang) }}</div>

{% if view.images.length %}
<ul class="gallery">
{% for image in view.images %}
	<li class="gallery__item">
		<figure class="gallery__figure">
			<a class="gallery__link" href="{{ url(image.fullUrl) }}" aria-label="{{ lang.gallery.open(image.title) }}">
				<img class="gallery__thumb" src="{{ url(image.thumbUrl) }}" alt="" loading="lazy">
			</a>
			<figcaption class="gallery__caption">
				<strong class="gallery__title">{{ image.title }}</strong>
				<span>{{ lang.gallery.addedBy }} {{ image.author }}</span>
				<span>{{ lang.gallery.addedAt }} {{ image.addedAt }}</span>
				<details class="gallery__description">
					<summary>{{ lang.gallery.description }}</summary>
					{#- HTML de parseMessage() : échappé par construction (services/bbcode.ts). #}
					<div class="bbcode">{{ image.descriptionHtml | safe }}</div>
				</details>
				{% if image.deleteUrl %}<a class="gallery__delete" href="{{ url(image.deleteUrl) }}" aria-label="{{ lang.gallery.deleteImageNamed(image.title) }}">{{ lang.gallery.deleteImage }}</a>{% endif %}
			</figcaption>
		</figure>
	</li>
{% endfor %}
</ul>
{% else %}
<p class="message-box">{{ view.emptyMessage }}</p>
{% endif %}

<div class="page-bar">{{ navigation.pagination(view.pagination, lang) }}</div>
{% endblock %}
