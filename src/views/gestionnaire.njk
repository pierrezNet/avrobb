{#- Gestionnaire de fichiers (gestionnaire.php). Données : `view` (presenters/profilePlugilePage.ts). -#}
{% extends "layout.njk" %}
{% import "partials/forms.njk" as forms %}
{% import "partials/sideMenu.njk" as sideMenu %}

{% block head %}<script src="{{ asset('js/gestionnaire.js') }}" defer></script>{% endblock %}

{% block main %}
<h1 class="page-title">{{ lang.profile.fileManager }}</h1>
<p class="page-intro">{{ lang.profile.fileManagerInfo }} <button type="button" class="link-button" data-close-window hidden>{{ lang.profile.closeWindow }}</button></p>
{{ sideMenu.notice(view.notice) }}
{{ forms.errors(lang.profile.formErrors, lang.profile.formErrorsInfo, view.errors) }}

<form id="upload" class="form-box form" method="post" enctype="multipart/form-data" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ lang.profile.uploadFileTitle }}</h2>
	<p class="form__field">
		<label for="fichier">{{ lang.profile.chooseFile }}</label>
		<input type="file" id="fichier" name="fichier" required>
	</p>
	<p class="form__help">{% if view.limits %}{{ view.limits }}{% else %}{{ lang.profile.noExtensionAllowed }}{% endif %}</p>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="submit" value="1"{% if not view.limits %} disabled{% endif %}>{{ lang.profile.send }}</button></p>
</form>

<form id="files" class="form-box" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<h2 class="form-box__title">{{ lang.profile.myUploads }}</h2>
	{% if view.usage %}<p class="upload-usage"><strong>{{ lang.profile.usedSpace }}</strong> <progress max="100" value="{{ view.usage.percent }}">{{ view.usage.percent }} %</progress> {{ view.usage.percent }} % - {{ view.usage.text }}</p>{% endif %}
	{% if view.files and view.files.length %}
	<ul class="upload-list">
		{% for file in view.files %}
		<li class="upload-list__item">
			<a class="upload-list__preview" href="{{ file.href }}" target="_blank" rel="noopener">{% if file.thumbnailUrl %}<img src="{{ file.thumbnailUrl }}" alt="" loading="lazy">{% else %}<span>{{ lang.profile.noPreview }}</span>{% endif %}</a>
			<span class="upload-list__name">
				<a href="{{ file.href }}" target="_blank" rel="noopener">{{ file.name }}</a> [{{ file.size }}] [{{ file.extension }}]
				<label class="visually-hidden" for="url-{{ loop.index }}">{{ lang.profile.fileAddress(file.value) }}</label>
				<input type="text" id="url-{{ loop.index }}" class="upload-list__url" value="{{ file.publicUrl }}" readonly>
			</span>
			<button type="button" class="button button--small" data-insert="{{ file.insertCode }}" aria-label="{{ lang.profile.insertInto(file.value) }}" hidden>{{ lang.profile.insert }}</button>
			<label class="upload-list__select"><input type="checkbox" name="delete" value="{{ file.value }}"> <span class="visually-hidden">{{ lang.profile.deleteFile(file.value) }}</span><span aria-hidden="true">{{ lang.profile.delete }}</span></label>
		</li>
		{% endfor %}
	</ul>
	<p class="form__buttons"><button type="submit" class="button" name="supprimer" value="1">{{ lang.profile.delete }}</button></p>
	{% else %}
	<p>{{ lang.profile.noUploads }}</p>
	{% endif %}
	<p class="visually-hidden" role="status" data-insert-status data-message="{{ lang.profile.inserted }}"></p>
</form>
{% endblock %}
