{#- Index des forums (index.php). Données : `view` (presenters/indexPage.ts). -#}
{% extends "layout.njk" %}
{% import "partials/people.njk" as people %}
{% import "partials/actions.njk" as actions %}
{% import "partials/subject.njk" as subjectParts %}

{% block main %}
<h1 class="visually-hidden">{{ layout.boardTitle }}</h1>

{% for category in view.categories %}
<section class="category" id="idx{{ loop.index }}" aria-labelledby="cat{{ category.id }}">
	<h2 class="category__title" id="cat{{ category.id }}">{{ category.name }}</h2>
	<div class="forum-list__head" aria-hidden="true">
		<span>{{ lang.index.topics }}</span> <span>{{ lang.index.posts }}</span> <span>{{ lang.index.lastPost }}</span>
	</div>
	<ul class="forum-list">
	{% for forum in category.forums %}
		<li class="forum-row{% if forum.newPostsUrl %} forum-row--new{% endif %}{% if forum.isRedirect %} forum-row--redirect{% endif %}">
			<div class="forum-row__main">
				<h3 class="forum-row__name">
					{%- if forum.isRedirect -%}
					<span class="forum-row__redirect">{{ lang.index.linkTo }}</span> <a href="{{ forum.href }}">{{ forum.name }}</a>
					{%- else -%}
					<a href="{{ url(forum.href) }}">{{ forum.name }}</a>
					{%- endif -%}
					{% if forum.newPostsUrl %} <a class="badge badge--new" href="{{ url(forum.newPostsUrl) }}">{{ lang.index.newPosts }}</a>{% endif %}
				</h3>
				{#- forums.forum_desc : HTML saisi par l'administrateur, affiché tel quel comme dans index.php. #}
				{% if forum.descriptionHtml %}<div class="forum-row__desc">{{ forum.descriptionHtml | safe }}</div>{% endif %}
				{% if forum.moderators.length %}
				<p class="forum-row__mods">(<em>{{ lang.index.moderatedBy }}</em> {% for moderator in forum.moderators %}{{ people.person(moderator) }}{% if not loop.last %}, {% endif %}{% endfor %})</p>
				{% endif %}
			</div>
			<dl class="forum-row__stats">
				<div class="forum-row__count"><dt>{{ lang.index.topics }}</dt> <dd>{{ forum.numTopics }}</dd></div>
				<div class="forum-row__count"><dt>{{ lang.index.posts }}</dt> <dd>{{ forum.numPosts }}</dd></div>
				<div class="forum-row__last">
					<dt>{{ lang.index.lastPost }}</dt>
					<dd>{% if forum.lastPost %}<a href="{{ url(forum.lastPost.href) }}">{{ forum.lastPost.at }}</a> <span class="forum-row__by">{{ lang.index.by }} {{ forum.lastPost.by }}</span>{% else %}{{ forum.lastPostPlaceholder }}{% endif %}</dd>
				</div>
			</dl>
		</li>
	{% endfor %}
	</ul>
</section>
{% else %}
<p class="message-box" id="idx0">{{ lang.index.emptyBoard }}</p>
{% endfor %}

{% if view.markReadUrl %}
<div class="page-bar">{{ actions.postButton(layout, view.markReadUrl, lang.index.markAllAsRead) }}</div>
{% endif %}

{#- Activité de la semaine (AvroBB), à la place de « Informations sur les forums ». -#}
<div class="home-activity">
<div class="home-row">
{% if view.online %}
<section class="home-block home-block--online" id="onlinelist" aria-labelledby="online-title">
	<h2 class="home-block__title" id="online-title">{{ lang.index.nowOnline }}</h2>
	{% if view.online.users.length or view.online.guests %}
	<ul class="online-avatars">
		{% for user in view.online.users %}
		<li>{% if user.href %}<a href="{{ url(user.href) }}" title="{{ user.label }}">{% else %}<span title="{{ user.label }}">{% endif %}
			{%- if user.avatarUrl %}<img src="{{ user.avatarUrl }}" alt="" loading="lazy">{% else %}<span class="online-avatars__initial" aria-hidden="true">{{ user.initial }}</span>{% endif -%}
			<span class="online-avatars__name">{{ user.label }}</span>
		{%- if user.href %}</a>{% else %}</span>{% endif %}</li>
		{% endfor %}
		{% if view.online.guests %}<li class="online-avatars__guests">{{ view.online.guests }}</li>{% endif %}
	</ul>
	{% else %}
	<p class="home-block__empty">{{ lang.index.nobodyOnline }}</p>
	{% endif %}
</section>
{% endif %}

{% if view.newMembers.length %}
<section class="home-block home-block--welcome" aria-labelledby="welcome-title">
	<h2 class="home-block__title" id="welcome-title">{{ lang.index.newMembers }}</h2>
	<p class="home-block__people">{% for member in view.newMembers %}{{ people.person(member) }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
	<p class="home-block__hint">{{ lang.index.newMembersInfo }}</p>
</section>
{% endif %}
</div>

<section class="home-block home-block--hot" aria-labelledby="hot-title">
	<h2 class="home-block__title" id="hot-title">{{ lang.index.hotTopics }}</h2>
	{% if view.hotTopics.length %}
	<ul class="hot-topics">
		{% for topic in view.hotTopics %}
		<li class="hot-topics__item">
			<a class="hot-topics__card" href="{{ url(topic.href) }}">
				{% if topic.imageUrl %}<img class="hot-topics__image" src="{{ topic.imageUrl }}" alt="" loading="lazy">{% else %}<span class="hot-topics__image hot-topics__image--none" aria-hidden="true"></span>{% endif %}
				<span class="hot-topics__subject">{{ subjectParts.subject(topic.subject) }}</span>
				<span class="hot-topics__activity">{{ topic.activity }}</span>
			</a>
		</li>
		{% endfor %}
	</ul>
	{% else %}
	<p class="home-block__empty">{{ lang.index.noHotTopics }}</p>
	{% endif %}
</section>

{% if view.simulators.length %}
<section class="home-block home-block--sims" aria-labelledby="sims-title">
	<h2 class="home-block__title" id="sims-title">{{ lang.index.simulators }}</h2>
	<ul class="sim-shares">
		{% for sim in view.simulators %}
		<li class="sim-shares__row">
			<span class="subject-tag" style="background-color: {{ sim.background }}; color: {{ sim.foreground }}">{{ sim.name }}</span>
			<span class="sim-shares__bar" aria-hidden="true"><span style="width: {{ sim.percent }}%; background-color: {{ sim.background }}"></span></span>
			<span class="sim-shares__count"><span class="visually-hidden">{{ sim.label }}</span><span aria-hidden="true">{{ sim.count }}</span></span>
		</li>
		{% endfor %}
	</ul>
</section>
{% endif %}
</div>
{% endblock %}
