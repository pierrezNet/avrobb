{#- Mise en page commune (main.tpl + header.php + footer.php). Données : `layout` (presenters/layout.ts). -#}
{%- import "partials/actions.njk" as actions -%}
{%- import "partials/forms.njk" as forms -%}
<!DOCTYPE html>
<html lang="{{ lang.common.langCode }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ layout.pageTitle }}</title>
{% if layout.robotsNoIndex %}<meta name="robots" content="noindex, follow">
{% endif %}
{% if layout.canonicalUrl %}<link rel="canonical" href="{{ layout.canonicalUrl }}">
{% endif %}{% if layout.meta.description %}<meta name="description" content="{{ layout.meta.description }}">
{% endif %}
{% if not layout.robotsNoIndex %}{#- Aperçu de partage (réseaux sociaux, messageries) des pages indexables. -#}
<meta property="og:site_name" content="{{ layout.meta.siteName }}">
<meta property="og:title" content="{{ layout.meta.title }}">
<meta property="og:type" content="{{ layout.meta.type }}">
<meta property="og:locale" content="fr_FR">
{% if layout.meta.url %}<meta property="og:url" content="{{ layout.meta.url }}">
{% endif %}{% if layout.meta.description %}<meta property="og:description" content="{{ layout.meta.description }}">
{% endif %}<meta property="og:image" content="{{ layout.meta.image }}">
<meta name="twitter:card" content="summary_large_image">
{% endif %}
{% if layout.feed %}<link rel="alternate" type="{{ layout.feed.mimeType }}" href="{{ url(layout.feed.href) }}" title="{{ layout.feed.label }}">
{% endif %}
{#- Icônes AvroBB : SVG (nette à toutes les tailles), PNG de secours, écran d'accueil iOS et Android. -#}
<link rel="icon" href="{{ asset('icons/favicon.svg') }}" type="image/svg+xml">
<link rel="icon" href="{{ asset('icons/favicon-32.png') }}" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="{{ asset('icons/apple-touch-icon.png') }}">
<link rel="manifest" href="{{ asset('manifest.json') }}">
<meta name="theme-color" content="#1a293e">
<link rel="stylesheet" href="{{ asset('css/base.css') }}">
<link rel="stylesheet" href="{{ asset('css/themes/' ~ layout.theme ~ '.css') }}">
{% if layout.memberSuggest %}<script src="{{ asset('js/mentions.js') }}" defer></script>{% endif %}
{% block head %}{% endblock %}
</head>
<body{% if layout.memberSuggest %} data-profile-base="{{ layout.memberSuggest.profileBase }}" data-members-label="{{ lang.common.memberSuggestions }}"{% endif %}>
<a class="skip-link" href="#main">{{ lang.common.skipToContent }}</a>

<div id="pun{{ layout.pageId }}" class="page theme-{{ layout.theme }}">

{#- Bannière (page Apparence) en propriété CSS : affichée sur grand écran seulement (base.css). -#}
<header class="site-header" id="brdheader" style="--header-banner: url('{{ url(layout.header.bannerHref) }}')">
	<div class="site-header__bar">
		<a class="site-header__logo" href="{{ url('index.php') }}"><img src="{{ url(layout.header.logoHref) }}" alt="{{ layout.boardTitle }}" width="301" height="77"></a>
		<details class="site-nav" id="brdmenu">
			<summary class="site-nav__toggle">{{ lang.common.menu }}</summary>
			<nav aria-label="{{ lang.common.mainNav }}">
				<ul class="site-nav__list">
				{% for item in layout.nav %}
					<li id="{{ item.id }}" class="site-nav__item{% if item.active %} is-active{% endif %}{% if item.count %} has-news{% endif %}{% if item.mobileOnly %} site-nav__item--mobile{% endif %}">
					{%- if item.trustedHtml -%}
						{#- HTML saisi par l'administrateur (o_additional_navlinks), affiché tel quel comme dans header.php. -#}
						{{ item.trustedHtml | safe }}
					{%- elif item.post -%}
						<form class="site-nav__form" method="post" action="{{ url(item.href) }}">{{ forms.csrf(layout) }}<button type="submit" class="site-nav__button">{{ item.label }}</button></form>
					{%- else -%}
						<a href="{{ url(item.href) }}">{% if item.abbrTitle %}<abbr title="{{ item.abbrTitle }}">{{ item.label }}</abbr>{% else %}{{ item.label }}{% endif %}{% if item.count %} <span class="site-nav__count">{{ item.count }}<span class="visually-hidden"> {{ lang.common.unreadCount }}</span></span>{% endif %}</a>
					{%- endif -%}
					</li>
				{% endfor %}
				</ul>
			</nav>
		</details>
	</div>

	<div class="site-status" id="brdwelcome">
	{% if layout.status %}
		<ul class="site-status__info">
			<li>{{ lang.common.loggedInAs }}<strong>{{ layout.status.username }}</strong></li>
			<li class="site-status__wide">{{ layout.status.lastVisit }}</li>
			{% if layout.status.showAdminLink %}<li id="navadmin" class="site-status__wide"><a href="{{ url('admin_index.php') }}">{{ lang.common.admin }}</a></li>{% endif %}
			{% if layout.status.pendingReports %}<li class="site-status__alert"><a href="{{ url('admin_reports.php') }}">{{ lang.common.newReports }}</a></li>{% endif %}
			{% if layout.status.maintenance %}<li class="site-status__alert"><a href="{{ url('admin_maintenance.php#maintenance-mode') }}">{{ lang.common.maintenanceModeEnabled }}</a></li>{% endif %}
			{% if layout.status.privateMessageBox %}
				{% set box = layout.status.privateMessageBox %}
				<li>
				{%- if box.kind == 'full' -%}
					<a class="site-status__alert" href="{{ url('pms_inbox.php') }}">{{ box.text }}</a>
				{%- elif box.kind == 'filled' -%}
					<label class="pm-gauge">{{ box.text }} <progress max="100" value="{{ box.percent }}">{{ box.percent }}&#160;%</progress></label>
				{%- else -%}
					{{ box.text }}
				{%- endif -%}
				</li>
			{% endif %}
		</ul>
	{% else %}
		<p class="site-status__info">{{ lang.common.notLoggedIn }}</p>
	{% endif %}
	{% if layout.quickSearches.length %}
		<p class="site-status__searches">{{ lang.common.topicSearches }}
		{% for search in layout.quickSearches %}<a href="{{ url(search.href) }}" title="{{ search.title }}">{{ search.label }}</a>{% if not loop.last %} | {% endif %}{% endfor %}
		</p>
	{% endif %}
	</div>
</header>

{% if layout.ban %}
<aside class="announcement ban-notice" role="note">
	<p>{{ lang.common.banReadOnly }}{% if layout.ban.expires %} {{ lang.common.banExpires(layout.ban.expires) }}{% endif %}</p>
	{% if layout.ban.reason %}<p>{{ lang.common.banReason }} <strong>{{ layout.ban.reason }}</strong></p>{% endif %}
</aside>
{% endif %}
{% if layout.announcementHtml %}
<aside class="announcement" id="announce" aria-labelledby="announce-title">
	<h2 id="announce-title" class="announcement__title">{{ lang.common.announcement }}</h2>
	{#- HTML saisi par l'administrateur (o_announcement_message), affiché tel quel comme dans header.php. #}
	<div class="announcement__body">{{ layout.announcementHtml | safe }}</div>
</aside>
{% endif %}

<main id="main" class="site-main" tabindex="-1">
{% block main %}{% endblock %}
</main>

<footer class="site-footer" id="brdfooter">
	<h2 class="visually-hidden">{{ lang.common.boardFooter }}</h2>
	{% if layout.modControls.length %}
	<nav class="mod-controls" id="modcontrols" aria-label="{{ lang.common.modControls }}">
		<ul>
		{% for control in layout.modControls %}
			<li>{% if control.post %}{{ actions.postButton(layout, control.href, control.label) }}{% else %}<a href="{{ url(control.href) }}">{{ control.label }}</a>{% endif %}</li>
		{% endfor %}
		</ul>
	</nav>
	{% endif %}
	<div class="site-footer__nav">
		<nav class="footer-links" aria-label="{{ lang.common.footerNav }}">
			<ul>
			{% for link in layout.footerLinks %}<li><a href="{{ url(link.href) }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.label }}</a></li>{% endfor %}
			</ul>
		</nav>
		<div class="site-footer__info">
			{% if layout.feed %}<p class="feed-link feed-link--{{ layout.feed.cssClass }}" id="feedlinks"><a href="{{ url(layout.feed.href) }}">{{ layout.feed.label }}</a></p>{% endif %}
			<p id="poweredby">{{ lang.common.poweredBy }} <a href="https://github.com/pierrezNet/">AvroBB</a></p>
		</div>
	</div>
</footer>

</div>
</body>
</html>
