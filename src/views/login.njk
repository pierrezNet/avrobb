{#- Connexion (login.php). Données : `view.providers`, `view.devLogin`, `view.redirectUrl`. -#}
{% extends "layout.njk" %}
{% import "partials/forms.njk" as forms %}

{% block main %}
<h1 class="page-title">{{ lang.login.login }}</h1>

<section class="form-box sso-login" aria-labelledby="sso-title">
	<h2 class="visually-hidden" id="sso-title">{{ lang.login.login }}</h2>
	<p>{{ lang.login.intro }}</p>
	{% if view.providers.length %}
	<ul class="sso-login__providers">
		{% for provider in view.providers %}<li><a class="button button--primary sso-login__button sso-login__button--{{ provider.id }}" href="{{ url(provider.href) }}">{{ provider.label }}</a></li>{% endfor %}
	</ul>
	{% else %}
	<p class="form__help">{{ lang.login.noProvider }}</p>
	{% endif %}
	<p class="form__help">{{ lang.login.privacyInfo }} <a href="{{ url('privacy.php') }}">{{ lang.login.privacyLink }}</a>.</p>
</section>

{% if view.devLogin %}
<form id="login" class="form-box form" method="post" action="{{ url('login.php?action=in') }}">
	{{ forms.csrf(layout) }}
	<input type="hidden" name="redirect_url" value="{{ view.redirectUrl }}">
	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ lang.login.devLoginLegend }}</legend>
		<p class="form__field">
			<label for="login-username">{{ lang.login.username }} <span class="form__required">{{ lang.login.required }}</span></label>
			<input type="text" id="login-username" name="req_username" maxlength="25" required autocomplete="username" autocapitalize="none" spellcheck="false">
		</p>
		<p class="form__help">{{ lang.login.devLoginInfo }}</p>
	</fieldset>
	<p class="form__buttons"><button type="submit" class="button button--primary">{{ lang.login.submit }}</button></p>
</form>
{% endif %}
{% endblock %}
