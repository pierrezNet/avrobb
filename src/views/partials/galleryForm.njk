{#- Formulaire d'envoi d'une image dans la galerie (gallery.php?info=new et sélecteur ?info=pick). -#}
{% import "partials/forms.njk" as forms %}

{% macro uploadForm(form, layout, lang) %}
<form class="form-box form" method="post" enctype="multipart/form-data" action="{{ url(form.formAction) }}" data-gallery-upload>
	{{ forms.csrf(layout) }}
	<input type="hidden" name="form_sent" value="1">
	<p class="form__field">
		<label for="titre">{{ lang.gallery.titleField }} <span class="form__required">{{ lang.gallery.required }}</span></label>
		<input type="text" id="titre" name="titre" value="{{ form.title }}" maxlength="40" required>
	</p>
	<p class="form__field">
		<label for="description">{{ lang.gallery.descriptionField }} <span class="form__required">{{ lang.gallery.required }}</span></label>
		<textarea id="description" name="description" rows="4" maxlength="2000" required>{{ form.description }}</textarea>
	</p>
	<p class="form__help">{{ lang.gallery.descriptionHelp }}</p>
	<p class="form__field">
		<label for="req_file">{{ lang.gallery.imageField }} <span class="form__required">{{ lang.gallery.required }}</span></label>
		<input type="file" id="req_file" name="req_file" accept="image/jpeg,image/gif,image/png" required>
	</p>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="upload" value="1">{{ lang.gallery.upload }}</button></p>
</form>
{% endmacro %}
