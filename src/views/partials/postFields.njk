{#- Champs communs aux formulaires de rédaction (post.php et réponse rapide de viewtopic). -#}

{#- Pseudo et e-mail d'un invité ; `guest` : { emailField, emailRequired }, `values` : saisie précédente. -#}
{% macro guestFields(guest, values, lang) %}
<div class="form__grid form__grid--two">
	<p class="form__field">
		<label for="req_username">{{ lang.post.guestName }} <span class="form__required">{{ lang.post.required }}</span></label>
		<input type="text" id="req_username" name="req_username" value="{{ values.username }}" maxlength="25" required autocomplete="nickname">
	</p>
	<p class="form__field">
		<label for="guest_email">{{ lang.post.email }}{% if guest.emailRequired %} <span class="form__required">{{ lang.post.required }}</span>{% endif %}</label>
		<input type="email" id="guest_email" name="{{ guest.emailField }}" value="{{ values.email }}" maxlength="80"{% if guest.emailRequired %} required{% endif %} autocomplete="email">
	</p>
</div>
{% endmacro %}

{#- Ce qui est permis dans le message, avec les liens d'aide et le sélecteur d'images de la galerie. -#}
{% macro bbcodeStatus(items, lang) %}
<ul class="bbcode-status">
	{% for item in items %}<li><a href="{{ url(item.href) }}" target="_blank">{{ item.label }}</a> {% if item.on %}{{ lang.post.on }}{% else %}{{ lang.post.off }}{% endif %}</li>{% endfor %}
	{#- rel="opener" (sinon implicite « noopener » des navigateurs) : le sélecteur, page du forum, insère les images dans ce formulaire par window.opener. #}
	<li><a href="{{ url('gallery.php?info=pick') }}" target="_blank" rel="opener">{{ lang.post.galleryPicker }}</a></li>
</ul>
{% endmacro %}

{#- Emplacement de la barre d'outils BBCode, remplie par public/js/toolbar.js (masquée sans JavaScript). -#}
{% macro toolbar(toolbar) %}
<div class="bbcode-toolbar" data-toolbar="{{ toolbar.config }}" data-toolbar-images="{{ url(toolbar.imageDir) }}" data-toolbar-for="req_message" hidden></div>
{% endmacro %}
