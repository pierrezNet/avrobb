{#- Sujet découpé en segments (services/subjectTags.ts) : pastilles de balises colorées, puis texte
    simple. Couleurs validées par le service. -#}
{% macro subject(parts) -%}
{%- for part in parts -%}
{%- if part.tag %}<span class="subject-tag" style="background-color: {{ part.tag.background }}; color: {{ part.tag.foreground }}">{{ part.text }}</span><span class="subject-tag-gap">&#160;</span>
{%- else %}{{ part.text }}{% endif -%}
{%- endfor -%}
{%- endmacro %}
