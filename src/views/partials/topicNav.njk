{# Fil d'Ariane, pagination et lien « Répondre », affichés au-dessus et au-dessous des messages. #}

{% macro crumbs(view, lang) %}
<ul class="crumbs">
	<li><a href="{{ url('index.php') }}">{{ lang.index }}</a></li>
	<li><span>»&#160;</span><a href="{{ url('viewforum.php?id=' ~ view.forum.id) }}">{{ view.forum.name }}</a></li>
	<li><span>»&#160;</span><strong><a href="viewtopic.php?id={{ view.topic.id }}">{{ view.topic.subject }}</a></strong></li>
</ul>
{% endmacro %}

{% macro pagepost(view, lang) %}
<div class="pagepost">
	<p class="pagelink conl">
		<span class="pages-label">{{ lang.pages }} </span>
		{%- for link in view.pagination %}
			{% if link.kind == 'previous' %}
				<a rel="prev" class="item1" href="viewtopic.php?id={{ view.topic.id }}{% if link.page > 1 %}&amp;p={{ link.page }}{% endif %}">{{ lang.previous }}</a>
			{% elif link.kind == 'next' %}
				<a rel="next" href="viewtopic.php?id={{ view.topic.id }}&amp;p={{ link.page }}">{{ lang.next }}</a>
			{% elif link.kind == 'gap' %}
				<span class="spacer">…</span>
			{% elif link.current %}
				<strong{% if loop.first %} class="item1"{% endif %}>{{ link.page }}</strong>
			{% else %}
				<a{% if loop.first %} class="item1"{% endif %} href="viewtopic.php?id={{ view.topic.id }}{% if link.page > 1 %}&amp;p={{ link.page }}{% endif %}">{{ link.page }}</a>
			{% endif %}
		{%- endfor %}
	</p>
	{% if view.canReply %}
		<p class="postlink conr">{% if view.topic.closed %}{{ lang.topicClosed }} / {% endif %}<a href="{{ url('post.php?tid=' ~ view.topic.id) }}">{{ lang.postReply }}</a></p>
	{% elif view.topic.closed %}
		<p class="postlink conr">{{ lang.topicClosed }}</p>
	{% endif %}
</div>
{% endmacro %}
