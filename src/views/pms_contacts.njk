{#- Carnet d'adresses de la messagerie privée (pms_contacts.php). Données : `view` (presenters/privateMessagesPage.ts). -#}
{% extends "layout.njk" %}
{% import "partials/forms.njk" as forms %}
{% import "partials/people.njk" as people %}
{% import "partials/sideMenu.njk" as sideMenu %}

{% block main %}
<h1 class="page-title">{{ lang.pms.contacts }}</h1>
<div class="side-layout">
{{ sideMenu.sideMenu(lang.pms.pmMenu, view.menu) }}
<div class="side-layout__content">
{{ sideMenu.notice(view.notice) }}
{{ forms.errors(lang.pms.formErrorsTitle, lang.pms.formErrorsInfo, view.errors) }}
<form class="form-box form" method="post" action="{{ url('pms_contacts.php') }}">
	{{ forms.csrf(layout) }}
	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ lang.pms.addContact }}</legend>
		<p class="form__field">
			<label for="req_username">{{ lang.pms.contactName }}</label>
			<input type="text" id="req_username" name="req_username" maxlength="120" required autocomplete="off" data-member-list>
		</p>
		<p class="form__check"><label><input type="checkbox" name="req_refuse" value="1"> {{ lang.pms.refuseUser }}</label></p>
	</fieldset>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="add" value="1">{{ lang.pms.add }}</button></p>
</form>

<form id="contacts" method="post" action="{{ url('pms_contacts.php') }}">
	{{ forms.csrf(layout) }}
	<section class="category" aria-labelledby="contacts-title">
		<h2 class="category__title" id="contacts-title">{{ lang.pms.contacts }}</h2>
		{% if view.contacts.length %}
		<ul class="forum-list">
		{% for contact in view.contacts %}
			<li class="forum-row contact-row{% if not contact.allowed %} topic-row--closed{% endif %}">
				<div class="forum-row__main">
					<h3 class="forum-row__name">{{ people.person(contact.name) }}</h3>
					<p>{{ lang.pms.rightsContact }}&#160;: {% if contact.allowed %}{{ lang.pms.authorizedMessages }}{% else %}{{ lang.pms.refusedMessages }}{% endif %}</p>
				</div>
				<p class="contact-row__actions">
					<button type="submit" class="link-button" name="switch" value="{{ contact.id }}" title="{{ contact.switchTitle }}">{{ contact.switchLabel }}</button>
					<a href="{{ url(contact.messageUrl) }}" title="{{ contact.messageTitle }}">{{ lang.pms.quickMessage }}</a>
					<button type="submit" class="link-button" name="delete" value="{{ contact.id }}" title="{{ contact.deleteTitle }}">{{ lang.pms.delete }}</button>
				</p>
				<p class="topic-row__select"><label><input type="checkbox" name="selected" value="{{ contact.id }}"> <span class="visually-hidden">{{ contact.selectLabel }}</span><span aria-hidden="true">{{ lang.pms.select }}</span></label></p>
			</li>
		{% endfor %}
		</ul>
		{% else %}
		<p class="forum-row">{{ lang.pms.noContacts }}</p>
		{% endif %}
	</section>
	{% if view.contacts.length %}
	<p class="bulk-actions">
		<label for="contacts-action">{{ lang.pms.forSelect }}</label>
		<select id="contacts-action" name="action">
			<option value="send">{{ lang.pms.quickMessage }}</option>
			<option value="authorize">{{ lang.pms.authorize }}</option>
			<option value="refuse">{{ lang.pms.refuse }}</option>
			<option value="delete_multiple">{{ lang.pms.delete }}</option>
		</select>
		<button type="submit" class="button">{{ lang.pms.ok }}</button>
	</p>
	{% endif %}
</form>
</div>
</div>
{% endblock %}
