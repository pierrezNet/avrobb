{#- Écriture d'un message privé (pms_send.php). Données : `view` (presenters/privateMessagesPage.ts). -#}
{% extends "layout.njk" %}
{% import "partials/forms.njk" as forms %}
{% import "partials/postFields.njk" as postFields %}
{% import "partials/sideMenu.njk" as sideMenu %}

{% block head %}{% if view.newConversation and view.newConversation.lists.length %}<script src="{{ asset('js/pms.js') }}" defer></script>{% endif %}{% endblock %}

{% block main %}
<h1 class="page-title">{{ view.heading }}</h1>
<div class="side-layout">
{{ sideMenu.sideMenu(lang.pms.pmMenu, view.menu) }}
<div class="side-layout__content">
{{ forms.errors(lang.pms.errorsTitle, lang.pms.errorsInfo, view.errors) }}
{% if view.previewHtml %}
<section class="post post--preview" aria-labelledby="preview-title">
	<h2 class="post__meta" id="preview-title">{{ lang.post.preview }}</h2>
	{#- HTML produit par parseMessage() : échappé par construction (services/bbcode.ts). #}
	<div class="post__content"><div class="post__message bbcode">{{ view.previewHtml | safe }}</div></div>
</section>
{% endif %}
<form id="post" class="form-box form post-form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<input type="hidden" name="form_sent" value="1">
	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ lang.post.writeMessageLegend }}</legend>
		{% if view.newConversation %}
		<p class="form__field">
			<label for="p_username">{{ lang.pms.sendTo }} <span class="form__required">{{ lang.post.required }}</span></label>
			<input type="text" id="p_username" name="p_username" value="{{ view.newConversation.usernames }}" required autocomplete="off">
		</p>
		<p class="form__help">{{ lang.pms.sendMultiple(view.newConversation.maxReceivers) }}</p>
		{% if view.newConversation.lists.length %}
		<p class="form__field" id="sending-list" hidden>
			<label for="sending_list">{{ lang.pms.chooseList }}</label>
			<select id="sending_list" data-target="p_username">
				<option value="">{{ lang.pms.selectAList }}</option>
				{% for list in view.newConversation.lists %}<option value="{{ list.value }}">{{ list.label }}</option>{% endfor %}
			</select>
		</p>
		{% endif %}
		<p class="form__field">
			<label for="req_subject">{{ lang.pms.subject }} <span class="form__required">{{ lang.post.required }}</span></label>
			<input type="text" id="req_subject" name="req_subject" value="{{ view.newConversation.subject }}" maxlength="70" required>
		</p>
		{% endif %}
		<div class="form__field">
			<label for="req_message">{{ lang.post.message }} <span class="form__required">{{ lang.post.required }}</span></label>
			<textarea id="req_message" name="req_message" rows="14" required>{{ view.message }}</textarea>
		</div>
		{{ postFields.bbcodeStatus(view.bbcodeStatus, lang) }}
	</fieldset>
	{% if view.showSmiliesOption %}
	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ lang.post.options }}</legend>
		<p class="form__check"><label><input type="checkbox" name="hide_smilies" value="1"{% if view.hideSmilies %} checked{% endif %}> {{ lang.post.hideSmilies }}</label></p>
	</fieldset>
	{% endif %}
	<p class="form__buttons">
		<button type="submit" class="button button--primary" name="submit" value="1" accesskey="s">{{ lang.post.submit }}</button>
		<button type="submit" class="button" name="preview" value="1" accesskey="p">{{ lang.post.preview }}</button>
	</p>
</form>
</div>
</div>
{% endblock %}
