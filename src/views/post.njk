{#- Rédaction : réponse ou nouvelle discussion (post.php) et modification (edit.php). Données : `view` (presenters/postPage.ts). -#}
{% extends "layout.njk" %}
{% block head %}<script src="{{ asset('js/post.js') }}" defer></script>
{% if view.toolbar %}<script src="{{ asset('js/toolbar.js') }}" defer></script>{% endif %}{% endblock %}
{% import "partials/forms.njk" as forms %}
{% import "partials/navigation.njk" as navigation %}
{% import "partials/postFields.njk" as postFields %}

{% block main %}
{{ navigation.breadcrumbs(view.crumbs, lang) }}
<h1 class="page-title">{{ view.heading }}</h1>
{{ forms.errors(lang.post.postErrors, lang.post.postErrorsInfo, view.errors) }}

{% if view.previewHtml %}
<section class="post post--preview" id="postpreview" aria-labelledby="postpreview-title">
	<h2 class="post__meta" id="postpreview-title">{{ lang.post.postPreview }}</h2>
	<div class="post__content">
		{#- HTML de parseMessage() : échappé par construction (services/bbcode.ts). #}
		<div class="post__message bbcode">{{ view.previewHtml | safe }}</div>
	</div>
</section>
{% endif %}

<form id="post" class="form-box form post-form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<input type="hidden" name="form_sent" value="1">
	{% if view.form.draftId %}<input type="hidden" name="brouillon_id" value="{{ view.form.draftId }}">{% endif %}
	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ view.legend }}</legend>
		{% if view.guest %}{{ postFields.guestFields(view.guest, view.form, lang) }}{% endif %}
		{% if view.showSubject %}
		<p class="form__field">
			<label for="req_subject">{{ lang.post.subject }} <span class="form__required">{{ lang.post.required }}</span></label>
			<input type="text" id="req_subject" name="req_subject" value="{{ view.form.subject }}" maxlength="70" required>
		</p>
		{% endif %}
		{% if view.subjectPrefixes %}
		{#- Préfixes de sujet de PV : insérés par public/js/post.js, masqués sans JavaScript. #}
		<div class="subject-prefixes" data-subject-prefixes hidden>
			<p class="subject-prefixes__group"><span>{{ lang.post.simulators }}</span>
			{% for prefix in view.subjectPrefixes.simulators %}<button type="button" class="button button--small" data-prefix="[{{ prefix }}]">{{ prefix }}</button>{% endfor %}</p>
			<p class="subject-prefixes__group"><span>{{ lang.post.other }}</span>
			{% for prefix in view.subjectPrefixes.other %}<button type="button" class="button button--small" data-prefix="[{{ prefix }}]">{{ prefix }}</button>{% endfor %}</p>
		</div>
		{% endif %}
		<div class="form__field">
			<label for="req_message">{{ lang.post.message }} <span class="form__required">{{ lang.post.required }}</span></label>
			{% if view.toolbar %}{{ postFields.toolbar(view.toolbar) }}{% endif %}
			<textarea id="req_message" name="req_message" rows="14" required>{{ view.form.message }}</textarea>
		</div>
		{{ postFields.bbcodeStatus(view.bbcodeStatus, lang) }}
	</fieldset>

	{% if view.checkboxes.length %}
	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ lang.post.options }}</legend>
		{% for box in view.checkboxes %}
		<p class="form__check"><label><input type="checkbox" name="{{ box.name }}" value="1"{% if box.checked %} checked{% endif %}> {{ box.label }}</label></p>
		{% endfor %}
		{% if view.draftsUrl %}<p class="form__links"><a href="{{ url(view.draftsUrl) }}">{{ lang.drafts.myDrafts }}</a></p>{% endif %}
	</fieldset>
	{% endif %}

	<p class="form__buttons">
		<button type="submit" class="button button--primary" name="submit" value="1" accesskey="s">{{ lang.post.submit }}</button>
		<button type="submit" class="button" name="preview" value="1" accesskey="p">{{ lang.post.preview }}</button>
	</p>
</form>

{% if view.review.length %}
<section class="post-review" id="postreview" aria-labelledby="postreview-title">
	<h2 id="postreview-title" class="post-review__title">{{ lang.post.topicReview }}</h2>
	<div class="post-list">
	{% for post in view.review %}
	<article class="post post--review">
		<h3 class="post__meta"><span>{{ post.poster }}</span> <span class="post__date">{{ post.postedAt }}</span></h3>
		<div class="post__content">
			{#- HTML de parseMessage() : échappé par construction (services/bbcode.ts). #}
			<div class="post__message bbcode">{{ post.messageHtml | safe }}</div>
		</div>
	</article>
	{% endfor %}
	</div>
</section>
{% endif %}
{% endblock %}


