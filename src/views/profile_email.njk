{#- Changement d'adresse électronique (profile.php?action=change_email). Données : `view` (AccountController). -#}
{% extends "layout.njk" %}
{% import "partials/forms.njk" as forms %}
{% import "partials/sideMenu.njk" as sideMenu %}

{% block main %}
<h1 class="page-title">{{ view.heading }}</h1>
<div class="side-layout">
{{ sideMenu.menu(view.menu, lang) }}
<div class="side-layout__content">
{{ forms.errors(lang.profile.formErrors, lang.profile.formErrorsInfo, view.errors) }}
<form id="change_email" class="form-box form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<input type="hidden" name="form_sent" value="1">
	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ lang.profile.newEmailLegend }}</legend>
		<p class="form__field">
			<label for="req_new_email">{{ lang.profile.newEmail }} <span class="form__required">{{ lang.profile.required }}</span></label>
			<input type="email" id="req_new_email" name="req_new_email" value="{{ view.email }}" maxlength="80" required autocomplete="email">
		</p>
		<p class="form__field">
			<label for="req_password">{{ lang.profile.password }} <span class="form__required">{{ lang.profile.required }}</span></label>
			<input type="password" id="req_password" name="req_password" required autocomplete="current-password">
		</p>
		<p class="form__help">{{ lang.profile.emailInstructions }}</p>
	</fieldset>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="new_email" value="1">{{ lang.profile.submit }}</button></p>
</form>
</div>
</div>
{% endblock %}
