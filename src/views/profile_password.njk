{#- Changement de mot de passe (profile.php?action=change_pass). Données : `view` (AccountController). -#}
{% extends "layout.njk" %}
{% import "partials/forms.njk" as forms %}
{% import "partials/profileMenu.njk" as profileMenu %}

{% block main %}
<h1 class="page-title">{{ view.heading }}</h1>
<div class="profile-edit">
{{ profileMenu.menu(view.menu, lang) }}
<div class="profile-edit__content">
{{ forms.errors(lang.profile.formErrors, lang.profile.formErrorsInfo, view.errors) }}
<form id="change_pass" class="form-box form" method="post" action="{{ url(view.formAction) }}">
	{{ forms.csrf(layout) }}
	<input type="hidden" name="form_sent" value="1">
	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ lang.profile.changePassLegend }}</legend>
		{% if view.askOldPassword %}
		<p class="form__field">
			<label for="req_old_password">{{ lang.profile.oldPass }} <span class="form__required">{{ lang.profile.required }}</span></label>
			<input type="password" id="req_old_password" name="req_old_password" required autocomplete="current-password">
		</p>
		{% endif %}
		<div class="form__grid">
			<p class="form__field">
				<label for="req_new_password1">{{ lang.profile.newPass }} <span class="form__required">{{ lang.profile.required }}</span></label>
				<input type="password" id="req_new_password1" name="req_new_password1" minlength="6" required autocomplete="new-password">
			</p>
			<p class="form__field">
				<label for="req_new_password2">{{ lang.profile.confirmNewPass }} <span class="form__required">{{ lang.profile.required }}</span></label>
				<input type="password" id="req_new_password2" name="req_new_password2" minlength="6" required autocomplete="new-password">
			</p>
		</div>
		<p class="form__help">{{ lang.profile.passInfo }}</p>
	</fieldset>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="update" value="1">{{ lang.profile.submit }}</button></p>
</form>
</div>
</div>
{% endblock %}
