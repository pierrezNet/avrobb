{#- Membres ayant réagi à un message (reactions.php). Données : `view` (presenters/reactions.ts). Le contenu de #reactors est repris tel quel dans la fenêtre de reactions.js. -#}
{% extends "layout.njk" %}
{% import "partials/navigation.njk" as navigation %}

{% block main %}
<div class="reactors" id="reactors">
	<h1 class="page-title reactors__title">{{ view.title }}</h1>
	<nav class="reactors__tabs" aria-label="{{ lang.topic.reactionsLabel }}">
		{% for tab in view.tabs %}<a class="reactors__tab" href="{{ url(tab.href) }}"{% if tab.current %} aria-current="page"{% endif %}>{% if tab.emoji %}<span aria-hidden="true">{{ tab.emoji }}</span> <span class="visually-hidden">{{ tab.label }}</span>{% else %}{{ tab.label }} {% endif %}<span class="reactors__count">{{ tab.count }}</span></a>{% endfor %}
	</nav>
	{% if view.reactors.length %}
	<ul class="reactors__list">
		{% for reactor in view.reactors %}
		<li class="reactors__row">
			{% if reactor.avatarUrl %}<img class="reactors__avatar" src="{{ reactor.avatarUrl }}" alt="" loading="lazy">{% else %}<span class="reactors__avatar reactors__avatar--initial" aria-hidden="true">{{ reactor.initial }}</span>{% endif %}
			<span class="reactors__name">{% if reactor.profileUrl %}<a href="{{ url(reactor.profileUrl) }}">{{ reactor.username }}</a>{% else %}{{ reactor.username }}{% endif %}</span>
			<span class="reactors__emojis" title="{{ reactor.label }}"><span aria-hidden="true">{{ reactor.emoji }}</span><span class="visually-hidden">{{ reactor.label }}</span></span>
			<span class="reactors__at">{{ reactor.at }}</span>
		</li>
		{% endfor %}
	</ul>
	{% else %}
	<p class="reactors__empty">{{ lang.reactions.nobody }}</p>
	{% endif %}
	{% if view.pagination.length > 1 %}<div class="page-bar">{{ navigation.pagination(view.pagination, lang) }}</div>{% endif %}
	<p class="reactors__back"><a href="{{ url(view.postUrl) }}">{{ lang.reactions.backToPost }}</a></p>
</div>
{% endblock %}
