{#- Inscription (register.php). Données : `view` (RegisterController). -#}
{% extends "layout.njk" %}
{% import "partials/forms.njk" as forms %}

{% block main %}
<h1 class="page-title">{{ lang.register.title }}</h1>
{{ forms.errors(lang.register.errorsTitle, lang.register.errorsInfo, view.errors) }}

<form id="register" class="form-box form" method="post" action="{{ url('register.php?action=register') }}">
	{{ forms.csrf(layout) }}
	<input type="hidden" name="form_sent" value="1">
	<div class="form__intro">
		<h2 class="form-box__title">{{ lang.register.importantInformation }}</h2>
		<p>{{ lang.register.desc1 }}</p>
		<p>{{ lang.register.desc2 }}</p>
	</div>

	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ lang.register.usernameLegend }}</legend>
		<p class="form__field">
			<label for="req_user">{{ lang.register.username }} <span class="form__required">{{ lang.register.required }}</span></label>
			<input type="text" id="req_user" name="req_user" value="{{ view.state.username }}" maxlength="25" minlength="2" required autocomplete="username" autocapitalize="none" spellcheck="false">
		</p>
	</fieldset>

	{% if not view.verify %}
	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ lang.register.passLegend }}</legend>
		<div class="form__grid">
			<p class="form__field">
				<label for="req_password1">{{ lang.register.password }} <span class="form__required">{{ lang.register.required }}</span></label>
				<input type="password" id="req_password1" name="req_password1" minlength="6" required autocomplete="new-password">
			</p>
			<p class="form__field">
				<label for="req_password2">{{ lang.register.confirmPass }} <span class="form__required">{{ lang.register.required }}</span></label>
				<input type="password" id="req_password2" name="req_password2" minlength="6" required autocomplete="new-password">
			</p>
		</div>
		<p class="form__help">{{ lang.register.passInfo }}</p>
	</fieldset>
	{% endif %}

	<fieldset class="form__fieldset">
		<legend class="form__legend">{% if view.verify %}{{ lang.register.emailLegend2 }}{% else %}{{ lang.register.emailLegend }}{% endif %}</legend>
		{% if view.verify %}<p class="form__help">{{ lang.register.emailInfo }}</p>{% endif %}
		<div class="form__grid">
			<p class="form__field">
				<label for="req_email1">{{ lang.register.email }} <span class="form__required">{{ lang.register.required }}</span></label>
				<input type="email" id="req_email1" name="req_email1" value="{{ view.state.email1 }}" maxlength="80" required autocomplete="email">
			</p>
			{% if view.verify %}
			<p class="form__field">
				<label for="req_email2">{{ lang.register.confirmEmail }} <span class="form__required">{{ lang.register.required }}</span></label>
				<input type="email" id="req_email2" name="req_email2" value="{{ view.state.email2 }}" maxlength="80" required autocomplete="email">
			</p>
			{% endif %}
		</div>
	</fieldset>

	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ lang.register.localisationLegend }}</legend>
		<p class="form__help">{{ lang.register.timeZoneInfo }}</p>
		<p class="form__field">
			<label for="time_zone">{{ lang.register.timeZone }}</label>
			<select id="time_zone" name="timezone">
				{% for zone in view.timezones %}<option value="{{ zone.value }}"{% if zone.selected %} selected{% endif %}>{{ zone.label }}</option>{% endfor %}
			</select>
		</p>
		<p class="form__check"><label><input type="checkbox" name="dst" value="1"{% if view.state.dst %} checked{% endif %}> {{ lang.register.dst }}</label></p>
	</fieldset>

	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ lang.register.privacyLegend }}</legend>
		<p class="form__help">{{ lang.register.emailSettingInfo }}</p>
		{% for setting in view.emailSettings %}
		<p class="form__check"><label><input type="radio" name="email_setting" value="{{ setting.value }}"{% if setting.checked %} checked{% endif %}> {{ setting.label }}</label></p>
		{% endfor %}
	</fieldset>

	<p class="form__buttons"><button type="submit" class="button button--primary" name="register" value="1">{{ lang.register.register }}</button></p>
</form>
{% endblock %}
