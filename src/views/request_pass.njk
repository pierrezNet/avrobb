{#- Mot de passe oublié (login.php?action=forget). -#}
{% extends "layout.njk" %}
{% import "partials/forms.njk" as forms %}

{% block main %}
<h1 class="page-title">{{ lang.login.requestPass }}</h1>
{{ forms.errors(lang.login.newPasswordErrors, lang.login.newPasswordErrorsInfo, view.errors) }}

<form id="request_pass" class="form-box form" method="post" action="{{ url('login.php?action=forget_2') }}">
	{{ forms.csrf(layout) }}
	<input type="hidden" name="form_sent" value="1">
	<fieldset class="form__fieldset">
		<legend class="form__legend">{{ lang.login.requestPassLegend }}</legend>
		<p class="form__field">
			<label for="req_email">{{ lang.login.email }} <span class="form__required">{{ lang.login.required }}</span></label>
			<input type="email" id="req_email" name="req_email" maxlength="80" required autocomplete="email">
		</p>
		<p class="form__help">{{ lang.login.requestPassInfo }}</p>
	</fieldset>
	<p class="form__buttons"><button type="submit" class="button button--primary" name="request_pass" value="1">{{ lang.login.submit }}</button></p>
</form>
{% endblock %}
