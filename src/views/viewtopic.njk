{#- Lecture d'un sujet (viewtopic.php). Données : `view` (presenters/topicPage.ts). -#}
{% extends "layout.njk" %}
{% import "partials/subject.njk" as subjectParts %}
{% import "partials/navigation.njk" as navigation %}
{% import "partials/forms.njk" as forms %}
{% import "partials/post.njk" as postView %}
{% import "partials/postFields.njk" as postFields %}
{% import "partials/actions.njk" as actions %}

{% macro topicBar(view, lang) %}
<div class="page-bar">
	{{ navigation.pagination(view.pagination, lang) }}
	{% if view.replyUrl or view.topic.closed or view.prefixesUrl %}
	<p class="page-bar__actions">
		{% if view.topic.closed %}<span class="badge">{{ lang.topic.topicClosed }}</span>{% endif %}
		{% if view.prefixesUrl %}<a class="button" href="{{ url(view.prefixesUrl) }}">{{ lang.topic.subjectPrefixes }}</a>{% endif %}
		{% if view.replyUrl %}<a class="button button--primary" href="{{ url(view.replyUrl) }}">{{ lang.topic.postReply }}</a>{% endif %}
	</p>
	{% endif %}
</div>
{% endmacro %}

{% block head %}{% if view.quickPost and view.quickPost.toolbar %}<script src="{{ asset('js/toolbar.js') }}" defer></script>{% endif %}<script src="{{ asset('js/quote-selection.js') }}" defer></script>{% endblock %}

{% block main %}
{{ navigation.breadcrumbs(view.crumbs, lang) }}
<h1 class="page-title">{{ subjectParts.subject(view.topic.subjectParts) }}</h1>
{{ topicBar(view, lang) }}

<div class="post-list">
{% for post in view.posts %}
{{ postView.article(post, view.topic.subject, lang) }}
{% endfor %}
</div>

{{ topicBar(view, lang) }}

{% if view.subscription %}
<p class="subscribelink forum-actions">
	{% if view.subscription.subscribed %}<span>{{ lang.topic.isSubscribed }} - </span>{{ actions.postButton(layout, view.subscription.action, lang.topic.unsubscribe) }}{% else %}{{ actions.postButton(layout, view.subscription.action, lang.topic.subscribe) }}{% endif %}
</p>
{% endif %}

{% if view.accept %}
<p class="forum-actions">{{ actions.postButton(layout, view.accept.action, view.accept.label) }}</p>
{% endif %}

{% if view.quickPost %}
<form id="quickpostform" class="form-box form post-form" method="post" action="{{ url(view.quickPost.formAction) }}" aria-labelledby="quickpost-title">
	<h2 id="quickpost-title" class="form-box__title">{{ lang.topic.quickPost }}</h2>
	{{ forms.csrf(layout) }}
	<input type="hidden" name="form_sent" value="1">
	{% if view.quickPost.keepSubscribed %}<input type="hidden" name="subscribe" value="1">{% endif %}
	{% if view.quickPost.guest %}{{ postFields.guestFields(view.quickPost.guest, { username: '', email: '' }, lang) }}{% endif %}
	<div class="form__field">
		<label for="req_message">{{ lang.post.message }} <span class="form__required">{{ lang.post.required }}</span></label>
		{% if view.quickPost.toolbar %}{{ postFields.toolbar(view.quickPost.toolbar) }}{% endif %}
		<textarea id="req_message" name="req_message" rows="7" required data-mentions></textarea>
	</div>
	{{ postFields.bbcodeStatus(view.quickPost.bbcodeStatus, lang) }}
	<p class="form__buttons">
		<button type="submit" class="button button--primary" name="submit" value="1" accesskey="s">{{ lang.post.submit }}</button>
		<button type="submit" class="button" name="preview" value="1" accesskey="p">{{ lang.post.preview }}</button>
	</p>
</form>
{% endif %}

{{ navigation.breadcrumbs(view.crumbs, lang) }}
{% endblock %}
