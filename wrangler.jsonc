// Configuration Cloudflare d'AvroBB : Worker (src/worker.ts), base D1, fichiers R2, ressources
// statiques (public/), tâche planifiée. Les secrets (SESSION_SECRET) se posent par
// `wrangler secret put` ; en local, dans .dev.vars (non versionné, voir .dev.vars.example).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "avrobb",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// Ressources de public/assets/ servies sous /assets/ sans appeler le Worker (en-têtes : public/_headers).
	// Toute autre adresse (pages, /img/…) passe au Worker.
	"assets": {
		"directory": "public",
		"binding": "ASSETS",
		"not_found_handling": "none"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "avrobb",
			// Identifiant de la base distante, donné par « wrangler d1 create avrobb --location weur » (README, Déploiement).
			"database_id": "cc42e32d-72d7-4f35-b3c9-626ba0244919",
			"migrations_dir": "migrations"
		}
	],
	// Galerie, avatars, logo et bannière ; servis par le Worker sous /img/ (accès public r2.dev désactivé).
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "avrobb-files" }],
	// Chaque nuit : purge de la table online et des fichiers orphelins (controllers/ScheduledTasks.ts).
	"triggers": { "crons": ["17 3 * * *"] },
	// Production : cookies Secure, connexion de développement toujours refusée (config.ts).
	// Secrets : SESSION_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET (et GOOGLE_* en option), ADMIN_ACCOUNTS.
	"vars": { "COOKIE_SECURE": "1", "ENVIRONMENT": "production" },
	// Limitation de débit par minute : connexion SSO par adresse IP (controllers/AuthController.ts),
	// écritures (messages, fichiers, profil, MP) et recherche par membre ou adresse (http/rateLimit.ts).
	"ratelimits": [
		{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
		{ "name": "SEARCH_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
	],
	"observability": { "enabled": true },
	// Domaine du forum, acheté chez Cloudflare Registrar : le Worker le reçoit directement (DNS et
	// certificat créés par Cloudflare au déploiement).
	"routes": [{ "pattern": "avrobb.org", "custom_domain": true }],
	// Port fixe : o_base_url et l'URL de retour OAuth (http://localhost:8787/auth/github/callback) en
	// dépendent ; un port occupé doit être une erreur, pas un glissement silencieux vers 8788.
	"dev": { "port": 8787 }
}
